{
  "name": "cache-cleaner",
  "description": "A disk cleaning Tool for Windows",
  "version": "1.0.0",
  "scripts": {
    "build": "npm run build-code && npm run build-bundle",
    "build-code": "tsc",
    "build-bundle": "esbuild build/main.js --sourcemap --bundle --outfile=dist/main.cjs --platform=node --format=cjs --external:@nodegui/nodegui \"--external:nodegui-plugin-*\"",
    "clean": "rimraf build dist install-pack",
    "package": "jam-pack-nodegui --config packaging/pack.json",
    "start": "npm run build && qode dist/main.cjs"
  },
  "author": "heyCHEEMS",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^20.3.1",
    "esbuild": "^0.18.4",
    "jam-pack-nodegui": "^0.18.0",
    "rimraf": "^5.0.1",
    "typescript": "^5.1.3"
  },
  "dependencies": {
    "@nodegui/nodegui": "^0.61.0",
    "source-map-support": "^0.5.21"
  }
}