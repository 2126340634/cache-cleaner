{
  "fetch": {
    "gitFromCwd": true
  },
  "prepare": {
    "tempDirectory": "./install-pack"
  },
  "build": {
    "packageManager": "npm"
  },
  "prune": {
    "skip": false,
    "patterns": [
      {
        "keep": [
          "LICENSE.txt",
          "README.md",
          "package.json",
          "dist/*.js",
          "dist/*.cjs",
          "assets/*"
        ]
      }
    ]
  },
  "addLauncher": {
    "jsEntryPoint": "dist/main.cjs"
  },
  "quietQode": {},
  "zip": {
    "platforms": [
      "windows"
    ],
    "skip": false
  },
  "nsis": {
    "skip": false,
    "description": "A disk cleaning Tool for Windows",
    "detailColors": "3db54a 000000",
    "appTitle": "Cache Cleaner"
  }
}